<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimmerRootAssembly>Whisper.net</TrimmerRootAssembly>
    <NoWarn>$(NoWarn);IL3000</NoWarn>
    <EnableGeneratedComInterfaceComImportInterop>true</EnableGeneratedComInterfaceComImportInterop>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
	<AssemblyName>tx</AssemblyName>  
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.1" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="9.8.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="OllamaSharp" Version="5.4.12" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="Whisper.net.AllRuntimes" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="models\\*.onnx" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="models\\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\installers\**" Link="installers\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="runtimes\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.Runtime.InteropServices.BuiltInComInterop.IsSupported" Value="true" />
  </ItemGroup>

  <PropertyGroup>
    <BuildMacAudio Condition="$([MSBuild]::IsOSPlatform('OSX')) and ('$(RuntimeIdentifier)' == '' or $(RuntimeIdentifier.StartsWith('osx-')))">true</BuildMacAudio>
    <MacAudioLibrary>$(MSBuildProjectDirectory)/$(BaseIntermediateOutputPath)native/$(Configuration)/$(RuntimeIdentifier)/libtranscribe_audio.dylib</MacAudioLibrary>
  </PropertyGroup>
  <ItemGroup Condition="'$(BuildMacAudio)' == 'true'">
    <None Include="$(MacAudioLibrary)" Link="libtranscribe_audio.dylib" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <Target Name="BuildMacSystemAudio" BeforeTargets="PrepareForBuild" Condition="'$(BuildMacAudio)' == 'true'"
          Inputs="$(MSBuildProjectDirectory)/MacAudio/SystemAudioCapture.m" Outputs="$(MacAudioLibrary)">
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(MacAudioLibrary)'))" />
    <Exec Command="xcrun clang -dynamiclib -fobjc-arc -O2 -Wall -Wextra -Wno-unused-parameter -arch arm64 -arch x86_64 -mmacosx-version-min=14.2 -framework Foundation -framework CoreAudio -framework AudioToolbox -install_name @rpath/libtranscribe_audio.dylib &quot;$(MSBuildProjectDirectory)/MacAudio/SystemAudioCapture.m&quot; -o &quot;$(MacAudioLibrary)&quot;" />
  </Target>

</Project>
